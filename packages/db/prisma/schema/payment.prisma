model PaymentPlan {
  id        String   @id @default(cuid())
  name      String
  credits   Int      // number of applications
  price     Float
  currency  String   // USD or NGN
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_plan")
}

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  credits   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_balance")
}

model PaymentIntent {
  id            String   @id @default(cuid())
  userId        String
  planId        String
  externalId    String?  @unique // Stripe Session ID or Paystack reference
  provider      String   // stripe or paystack
  amount        Float
  currency      String
  status        String   @default("pending") // pending, completed, failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_intent")
}
